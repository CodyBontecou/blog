{
  "name": "@blog/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@blog/*\" dev",
    "dev:blog": "vitepress dev",
    "dev:admin": "pnpm --filter @blog/admin dev",
    "dev:courses": "pnpm --filter @blog/courses dev",
    "dev:proxy": "sudo -E tsx scripts/dev-proxy.ts",
    "dev:subdomains": "USE_SUBDOMAIN_ROUTING=true concurrently --kill-others --names \"BLOG,ADMIN,COURSES,PROXY\" -c \"cyan,magenta,green,yellow\" \"pnpm dev:blog\" \"pnpm dev:admin\" \"pnpm dev:courses\" \"pnpm dev:proxy\"",
    "build": "pnpm --filter \"@blog/*\" build",
    "build:blog": "vitepress build",
    "build:admin": "pnpm --filter @blog/admin build",
    "build:courses": "pnpm --filter @blog/courses build",
    "build:tts": "tsx scripts/build-with-tts.ts",
    "preview": "vitepress preview",
    "newsletter": "tsx scripts/newsletter.ts",
    "newsletter:populate": "tsx scripts/populate-sent-newsletters.ts",
    "test:resend": "tsx scripts/test-resend.ts",
    "check:subscribers": "tsx scripts/check-subscribers.ts",
    "tts:generate": "tsx scripts/tts-generator.ts",
    "tts:test": "tsx scripts/test-tts.ts"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.5.3",
    "@supabase/supabase-js": "^2.50.3",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@vueuse/core": "^11.3.0",
    "class-variance-authority": "^0.7.0",
    "fluent-ffmpeg": "^2.1.3",
    "gray-matter": "^4.0.3",
    "lucide-vue-next": "^0.453.0",
    "marked": "^17.0.1",
    "prettier": "^3.4.2",
    "replicate": "^1.0.1",
    "resend": "^4.6.0",
    "rss": "^1.2.2",
    "sitemap": "^8.0.0",
    "stripe": "^20.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/http-proxy": "^1.17.17",
    "@types/rss": "^0.0.32",
    "@vercel/node": "^5.3.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.1.0",
    "http-proxy": "^1.18.1",
    "postcss": "^8.5.6",
    "radix-vue": "^1.9.8",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.3",
    "typescript": "^5.6.3",
    "vitepress": "^1.6.3"
  }
}
