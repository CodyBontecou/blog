{
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @blog/vitepress build",
  "outputDirectory": ".vitepress/dist",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "redirects": [
    {
      "source": "/(.+)/",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/(.+)\\.html",
      "destination": "/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.+)",
      "destination": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ]
}